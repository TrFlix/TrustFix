# ---------------------------------------------------------------------------
# TrustFix environment variables
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

# Frontend
PUBLIC_API_URL=http://localhost:5000/api

# Backend
PORT=5000
CLIENT_ORIGIN=http://localhost:4321

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trustfix

# Use a long random string in a real deployment
JWT_SECRET=trustfix-local-development-secret-change-me
JWT_EXPIRES_IN=7d
