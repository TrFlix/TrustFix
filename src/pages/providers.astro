---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../scripts/api.js';
import { icon } from '../scripts/icons.js';
---

<Layout
  title="Find verified professionals"
  description="Browse verified electricians, plumbers, AC technicians, cleaners, carpenters and more on TrustFix."
  activeNav="providers"
>
  <section class="border-b border-hairline bg-surface">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow">Verified professionals</p>
      <div class="mt-3 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h1 class="display-2 max-w-2xl">Find someone you can trust with your home.</h1>
          <p class="lead mt-3 max-w-xl">
            Compare experience, ratings and starting prices before you request a
            service.
          </p>
        </div>
        <div class="flex items-center gap-2 text-[12px] text-mute">
          <Fragment set:html={icon('badgeCheck', 'h-4 w-4 text-teal-deep')} />
          Every profile is reviewed before listing
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad pt-8 sm:pt-10">
    <div class="container-x">
      <form id="provider-filters" class="card p-3 sm:p-4" role="search" aria-label="Filter professionals">
        <div class="grid gap-3 md:grid-cols-[1.4fr_0.8fr_0.9fr_0.8fr_auto]">
          <div class="relative">
            <label for="provider-q" class="sr-only">Search professionals</label>
            <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-mute">
              <Fragment set:html={icon('search', 'h-4 w-4')} />
            </span>
            <input
              id="provider-q"
              name="q"
              type="search"
              class="input pl-9"
              placeholder="Search by name or skill"
              autocomplete="off"
            />
          </div>

          <div class="relative">
            <label for="provider-city" class="sr-only">City</label>
            <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-mute">
              <Fragment set:html={icon('pin', 'h-4 w-4')} />
            </span>
            <input
              id="provider-city"
              name="city"
              type="text"
              class="input pl-9"
              placeholder="City"
              autocomplete="address-level2"
            />
          </div>

          <div>
            <label for="provider-category" class="sr-only">Category</label>
            <select id="provider-category" name="category" class="input">
              <option value="">All categories</option>
              {CATEGORIES.map((category) => (
                <option value={category.slug}>{category.name}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="provider-sort" class="sr-only">Sort professionals</label>
            <select id="provider-sort" name="sort" class="input">
              <option value="recommended">Recommended</option>
              <option value="rating">Highest rated</option>
              <option value="experience">Most experienced</option>
              <option value="price-low">Lowest starting price</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary md:w-auto">
            Search
            <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
          </button>
        </div>

        <div class="mt-3 flex flex-wrap items-center gap-1.5 border-t border-hairline pt-3">
          <button
            type="button"
            class="rounded-full border border-navy bg-navy px-3 py-1.5 text-[11px] font-medium text-white transition"
            data-provider-chip=""
          >
            All
          </button>
          {CATEGORIES.map((category) => (
            <button
              type="button"
              class="rounded-full border border-hairline bg-surface px-3 py-1.5 text-[11px] text-body transition hover:border-teal-line hover:text-teal-deep"
              data-provider-chip={category.slug}
            >
              {category.name}
            </button>
          ))}
          <button type="button" id="provider-reset" class="ml-auto hidden items-center gap-1 text-[11px] text-mute transition hover:text-ink">
            <Fragment set:html={icon('x', 'h-3 w-3')} /> Reset
          </button>
        </div>
      </form>

      <div class="mt-8 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold tracking-[-0.02em] text-ink">Professionals near you</h2>
          <p id="provider-count" class="mt-0.5 text-[12px] text-mute" aria-live="polite">Loading professionals…</p>
        </div>
        <p class="text-[11px] text-mute">Starting prices are set by each professional.</p>
      </div>

      <div id="provider-results" class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-live="polite" aria-busy="true">
        {
          Array.from({ length: 6 }).map(() => (
            <div class="card p-5">
              <div class="flex items-center gap-3">
                <div class="skeleton h-12 w-12 rounded-full"></div>
                <div class="flex-1 space-y-2">
                  <div class="skeleton h-3.5 w-3/4"></div>
                  <div class="skeleton h-3 w-1/2"></div>
                </div>
              </div>
              <div class="skeleton mt-4 h-3 w-2/3"></div>
              <div class="mt-5 flex items-center justify-between">
                <div class="skeleton h-5 w-24"></div>
                <div class="skeleton h-8 w-24 rounded-full"></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<script>
  // @ts-nocheck
  import { apiFetch, CATEGORIES } from '../scripts/api.js';
  import { providerCard, emptyState, errorState } from '../scripts/render.js';
  import { debounce } from '../scripts/ui.js';

  const form = document.getElementById('provider-filters');
  const qInput = document.getElementById('provider-q');
  const cityInput = document.getElementById('provider-city');
  const categorySelect = document.getElementById('provider-category');
  const sortSelect = document.getElementById('provider-sort');
  const results = document.getElementById('provider-results');
  const count = document.getElementById('provider-count');
  const resetButton = document.getElementById('provider-reset');
  const chips = [...document.querySelectorAll('[data-provider-chip]')];

  const params = new URLSearchParams(window.location.search);
  qInput.value = params.get('q') || '';
  cityInput.value = params.get('city') || '';
  if (params.get('category')) categorySelect.value = params.get('category');
  if (params.get('sort')) sortSelect.value = params.get('sort');

  let requestId = 0;

  function syncChips() {
    chips.forEach((chip) => {
      const active = chip.dataset.providerChip === categorySelect.value;
      chip.className = active
        ? 'rounded-full border border-navy bg-navy px-3 py-1.5 text-[11px] font-medium text-white transition'
        : 'rounded-full border border-hairline bg-surface px-3 py-1.5 text-[11px] text-body transition hover:border-teal-line hover:text-teal-deep';
      chip.setAttribute('aria-pressed', String(active));
    });

    const hasFilters =
      qInput.value || cityInput.value || categorySelect.value || sortSelect.value !== 'recommended';
    resetButton.classList.toggle('hidden', !hasFilters);
    resetButton.classList.toggle('flex', Boolean(hasFilters));
  }

  function updateUrl() {
    const query = new URLSearchParams();
    if (qInput.value.trim()) query.set('q', qInput.value.trim());
    if (cityInput.value.trim()) query.set('city', cityInput.value.trim());
    if (categorySelect.value) query.set('category', categorySelect.value);
    if (sortSelect.value !== 'recommended') query.set('sort', sortSelect.value);
    const value = query.toString();
    window.history.replaceState({}, '', value ? `?${value}` : window.location.pathname);
  }

  async function load() {
    const current = ++requestId;
    const query = new URLSearchParams();
    if (qInput.value.trim()) query.set('q', qInput.value.trim());
    if (cityInput.value.trim()) query.set('city', cityInput.value.trim());
    if (categorySelect.value) query.set('category', categorySelect.value);
    if (sortSelect.value) query.set('sort', sortSelect.value);

    results.setAttribute('aria-busy', 'true');
    count.textContent = 'Loading professionals…';
    syncChips();
    updateUrl();

    try {
      const { providers } = await apiFetch(`/providers?${query.toString()}`, {
        auth: false,
      });
      if (current !== requestId) return;

      results.innerHTML = providers.length
        ? providers.map(providerCard).join('')
        : `<div class="sm:col-span-2 lg:col-span-3">${emptyState(
            'No professionals match those filters',
            'Try a different city or category, or clear your filters to see everyone.',
            '<button type="button" class="btn btn-outline btn-sm" data-provider-clear>Clear filters</button>',
          )}</div>`;

      const category = CATEGORIES.find((item) => item.slug === categorySelect.value);
      count.textContent = `${providers.length} professional${providers.length === 1 ? '' : 's'} found${category ? ` in ${category.name}` : ''}${cityInput.value.trim() ? ` in ${cityInput.value.trim()}` : ''}`;

      results.querySelector('[data-provider-clear]')?.addEventListener('click', resetAll);
    } catch (error) {
      if (current !== requestId) return;
      results.innerHTML = `<div class="sm:col-span-2 lg:col-span-3">${errorState(error.message)}</div>`;
      count.textContent = 'Could not load professionals';
    } finally {
      if (current === requestId) results.setAttribute('aria-busy', 'false');
    }
  }

  function resetAll() {
    qInput.value = '';
    cityInput.value = '';
    categorySelect.value = '';
    sortSelect.value = 'recommended';
    load();
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    load();
  });

  qInput.addEventListener('input', debounce(load, 420));
  cityInput.addEventListener('input', debounce(load, 420));
  categorySelect.addEventListener('change', load);
  sortSelect.addEventListener('change', load);
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      categorySelect.value = chip.dataset.providerChip;
      load();
    });
  });
  resetButton.addEventListener('click', resetAll);

  syncChips();
  load();
</script>
