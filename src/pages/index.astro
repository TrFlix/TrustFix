---
import Layout from '../layouts/Layout.astro';
import { CATEGORIES } from '../scripts/api.js';
import { icon, categoryIcon, starIcon } from '../scripts/icons.js';

const stats = [
  { value: '2,000+', label: 'Services completed' },
  { value: '350+', label: 'Verified professionals' },
  { value: '4.8/5', label: 'Average customer rating' },
  { value: '12', label: 'Cities served' },
];

const steps = [
  {
    number: '01',
    title: 'Choose a service',
    body: 'Browse eight categories and pick the service your home needs. Every listing shows clear starting prices.',
    icon: 'search',
  },
  {
    number: '02',
    title: 'Find a trusted professional',
    body: 'Compare verified local experts by experience, location and customer reviews before you decide.',
    icon: 'users',
  },
  {
    number: '03',
    title: 'Book and get it fixed',
    body: 'Send a request with your preferred date, track the status, and get the job done — no back-and-forth calls.',
    icon: 'calendar',
  },
];

const reasons = [
  {
    title: 'Easy service discovery',
    body: 'Search by service, category or city and find the right expert in seconds.',
    icon: 'search',
  },
  {
    title: 'Transparent pricing',
    body: 'See starting prices before you book. No surprise charges or hidden fees.',
    icon: 'receipt',
  },
  {
    title: 'Experienced professionals',
    body: 'Every provider lists their experience, skills and service history.',
    icon: 'badgeCheck',
  },
  {
    title: 'Convenient booking',
    body: 'Request a visit for a date that suits you and track every status update.',
    icon: 'calendar',
  },
];

const heroChips = [
  { label: 'AC Repair', slug: 'ac-repair' },
  { label: 'Electrician', slug: 'electrician' },
  { label: 'Deep Cleaning', slug: 'home-cleaning' },
  { label: 'Plumbing', slug: 'plumbing' },
];
---

<Layout activeNav="home">
  <!-- ================================================================ HERO -->
  <section class="hero-atmosphere relative overflow-hidden border-b border-hairline">
    <div class="pointer-events-none absolute inset-0 hero-grid opacity-70"></div>
    <div class="container-x relative py-16 sm:py-20 lg:py-28">
      <div class="grid items-center gap-14 lg:grid-cols-[1.08fr_0.92fr] lg:gap-10">
        <div class="animate-rise">
          <p class="eyebrow flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-teal"></span>
            Trusted home services, without the guesswork
          </p>

          <h1 class="display-1 mt-5 max-w-[18ch]">
            Your Home Deserves the Right <span class="text-teal-deep">Professionals.</span>
          </h1>

          <p class="lead mt-6 max-w-xl">
            Find trusted local experts for everyday repairs, maintenance, and home
            services with TrustFix.
          </p>

          <form
            action="/services"
            method="get"
            class="mt-8 rounded-xl border border-hairline bg-surface p-2 shadow-lift sm:flex sm:items-center"
            role="search"
            aria-label="Search for home services"
          >
            <label class="flex flex-1 items-center gap-2.5 px-3 py-2.5 sm:py-2" for="hero-service">
              <span class="text-mute"><Fragment set:html={icon('search', 'h-4 w-4')} /></span>
              <span class="sr-only">What service do you need?</span>
              <input
                id="hero-service"
                name="q"
                type="search"
                placeholder="What do you need? e.g. AC repair"
                class="w-full border-0 bg-transparent p-0 text-sm text-ink placeholder:text-faint focus:ring-0 focus:outline-none"
              />
            </label>

            <span class="hidden h-8 w-px bg-hairline sm:block"></span>

            <label class="flex items-center gap-2.5 border-t border-hairline px-3 py-2.5 sm:w-44 sm:border-t-0 sm:border-l-0 sm:py-2" for="hero-city">
              <span class="text-mute"><Fragment set:html={icon('pin', 'h-4 w-4')} /></span>
              <span class="sr-only">Your city</span>
              <div class="flex items-center gap-2 w-full">
                <input
                  id="hero-city"
                  name="city"
                  type="text"
                  placeholder="Your city"
                  class="flex-1 border-0 bg-transparent p-0 text-sm text-ink placeholder:text-faint focus:ring-0 focus:outline-none"
                />
                <button type="button" id="use-location" class="btn btn-outline btn-sm">
                  Use my location
                  <Fragment set:html={icon('pin', 'h-3 w-3')} />
                </button>
              </div>
            </label>

            <button type="submit" class="btn btn-primary mt-2 w-full sm:mt-0 sm:ml-2 sm:w-auto">
              Find Services
              <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
            </button>
          </form>

          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="mr-1 text-[11px] text-mute">Popular:</span>
            {
              heroChips.map((chip) => (
                <a
                  href={`/services?category=${chip.slug}`}
                  class="rounded-full border border-hairline bg-surface/70 px-2.5 py-1 text-[11px] text-body transition hover:border-teal-line hover:text-teal-deep"
                >
                  {chip.label}
                </a>
              ))
            }
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-[12px] text-body">
            <span class="inline-flex items-center gap-2">
              <span class="text-teal-deep"><Fragment set:html={icon('shieldCheck', 'h-4 w-4')} /></span>
              Verified professionals
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="text-teal-deep"><Fragment set:html={icon('receipt', 'h-4 w-4')} /></span>
              Transparent pricing
            </span>
            <span class="inline-flex items-center gap-2">
              <span class="text-teal-deep"><Fragment set:html={icon('clock', 'h-4 w-4')} /></span>
              Easy scheduling
            </span>
          </div>
        </div>

        <!-- Hero illustration -->
        <div class="relative mx-auto w-full max-w-[500px] animate-rise [animation-delay:120ms]" aria-hidden="true">
          <div class="absolute -inset-6 rounded-[2.5rem] bg-teal-soft/45 blur-2xl"></div>

          <div class="relative rounded-2xl border border-hairline bg-surface/80 p-2.5 shadow-float backdrop-blur">
            <div class="rounded-xl border border-hairline bg-surface p-5">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="text-[10px] font-medium tracking-[0.11em] text-mute uppercase">Service request</p>
                  <p class="mt-1 text-sm font-semibold text-ink">#TF-2048</p>
                </div>
                <span class="badge badge-in_progress">
                  <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
                  In progress
                </span>
              </div>

              <div class="mt-4 flex items-start gap-3 rounded-lg border border-hairline bg-canvas/70 p-3.5">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-teal-soft text-teal-deep">
                  <Fragment set:html={icon('wind', 'h-5 w-5')} />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="text-[13px] font-semibold text-ink">AC Repair &amp; Service</p>
                  <p class="mt-0.5 text-[11px] text-mute">Deep clean · 90 minutes</p>
                </div>
                <p class="text-sm font-semibold text-ink">₹899</p>
              </div>

              <div class="mt-3 grid grid-cols-2 gap-3">
                <div class="rounded-lg border border-hairline px-3 py-2.5">
                  <p class="text-[9px] font-medium tracking-[0.1em] text-mute uppercase">Scheduled</p>
                  <p class="mt-1 text-[11px] font-medium text-ink">Sat, 24 Oct · 11:00</p>
                </div>
                <div class="rounded-lg border border-hairline px-3 py-2.5">
                  <p class="text-[9px] font-medium tracking-[0.1em] text-mute uppercase">Address</p>
                  <p class="mt-1 truncate text-[11px] font-medium text-ink">Indiranagar, Bengaluru</p>
                </div>
              </div>

              <div class="mt-3 flex items-center gap-3 rounded-lg border border-hairline px-3.5 py-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-navy-tint text-[11px] font-semibold text-navy">RV</span>
                <div class="min-w-0 flex-1">
                  <p class="text-[12px] font-medium text-ink">Rahul Verma</p>
                  <p class="text-[10px] text-mute">AC technician · 6 yrs experience</p>
                </div>
                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-ink">
                  <span class="text-amber">{starIcon('h-3 w-3')}</span> 4.9
                </span>
              </div>

              <div class="mt-4 flex items-center justify-between border-t border-hairline pt-3.5">
                <p class="text-[10px] text-mute">Professional is on the way</p>
                <span class="inline-flex items-center gap-1.5 rounded-md bg-navy px-2.5 py-1.5 text-[10px] font-medium text-white">
                  Track booking <Fragment set:html={icon('chevronRight', 'h-3 w-3')} />
                </span>
              </div>
            </div>
          </div>

          <!-- floating chips -->
          <div class="absolute -top-4 -right-3 hidden items-center gap-2 rounded-full border border-hairline bg-surface px-3 py-2 shadow-lift sm:flex">
            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-teal-soft text-teal-deep"><Fragment set:html={icon('shieldCheck', 'h-3.5 w-3.5')} /></span>
            <span class="text-[11px] font-medium text-ink">Verified pro</span>
          </div>

          <div class="absolute -bottom-5 -left-3 hidden items-center gap-3 rounded-xl border border-hairline bg-surface px-3.5 py-2.5 shadow-lift sm:flex">
            <div class="flex -space-x-1.5">
              <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-surface bg-navy-tint text-[8px] font-semibold text-navy">AS</span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-surface bg-teal-soft text-[8px] font-semibold text-teal-deep">MK</span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-surface bg-amber-soft text-[8px] font-semibold text-amber-ink">PJ</span>
            </div>
            <div>
              <div class="flex items-center gap-0.5 text-amber">
                {
                  Array.from({ length: 5 }).map(() => (
                    <span set:html={starIcon('h-2.5 w-2.5')} />
                  ))
                }
              </div>
              <p class="mt-0.5 text-[10px] text-body">4.8 from 2,000+ homes</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =============================================================== STATS -->
  <section class="border-b border-hairline bg-surface">
    <div class="container-x">
      <dl class="grid grid-cols-2 divide-x divide-y divide-hairline sm:grid-cols-4 sm:divide-y-0">
        {
          stats.map((stat, index) => (
            <div class:list={['px-4 py-7 text-center sm:py-8', index === 0 && 'sm:pl-0', index === stats.length - 1 && 'sm:pr-0']}>
              <dt class="order-2 mt-1.5 text-[11px] text-mute">{stat.label}</dt>
              <dd class="text-xl font-semibold tracking-[-0.02em] text-ink sm:text-2xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ========================================================== CATEGORIES -->
  <section class="section-pad" id="categories">
    <div class="container-x">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Popular categories</p>
          <h2 class="display-2 mt-3 max-w-xl">Help for every corner of your home.</h2>
        </div>
        <a href="/services" class="btn btn-outline btn-sm self-start sm:self-auto">
          Browse all services
          <Fragment set:html={icon('arrowRight', 'h-3.5 w-3.5')} />
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          CATEGORIES.map((category) => (
            <a
              href={`/services?category=${category.slug}`}
              class="card card-hover group flex flex-col p-5"
            >
              <div class="flex items-start justify-between">
                <span class="flex h-11 w-11 items-center justify-center rounded-lg border border-hairline bg-surface-soft text-navy transition group-hover:border-teal-line group-hover:bg-teal-soft group-hover:text-teal-deep">
                  <span set:html={categoryIcon(category.slug, 'h-5 w-5')} />
                </span>
                <span class="text-faint transition group-hover:translate-x-0.5 group-hover:text-teal-deep">
                  <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
                </span>
              </div>
              <h3 class="mt-5 text-[15px] font-semibold tracking-[-0.01em] text-ink">
                {category.name}
              </h3>
              <p class="mt-1.5 text-[12.5px] leading-5 text-body">{category.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-medium text-teal-deep">
                Explore service
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================== FEATURED -->
  <section class="border-y border-hairline bg-surface">
    <div class="section-pad container-x">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Featured professionals</p>
          <h2 class="display-2 mt-3">Meet a few of the people behind TrustFix.</h2>
          <p class="lead mt-3 max-w-xl">
            Experienced, reviewed and ready to help — browse profiles and request
            a service in minutes.
          </p>
        </div>
        <a href="/providers" class="btn btn-outline btn-sm self-start sm:self-auto">
          View all professionals
          <Fragment set:html={icon('arrowRight', 'h-3.5 w-3.5')} />
        </a>
      </div>

      <div id="featured-providers" class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-live="polite">
        {
          Array.from({ length: 4 }).map(() => (
            <div class="card overflow-hidden">
              <div class="space-y-3 p-5">
                <div class="flex items-center gap-3">
                  <div class="skeleton h-12 w-12 rounded-full"></div>
                  <div class="flex-1 space-y-2">
                    <div class="skeleton h-3.5 w-3/4"></div>
                    <div class="skeleton h-3 w-1/2"></div>
                  </div>
                </div>
                <div class="skeleton h-3 w-2/3"></div>
              </div>
              <div class="border-t border-hairline p-4">
                <div class="skeleton h-8 w-full rounded-md"></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================== HOW IT WORKS -->
  <section class="section-pad" id="how-it-works">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">How TrustFix works</p>
        <h2 class="display-2 mt-3">From “something’s broken” to fixed.</h2>
        <p class="lead mt-4">
          Three simple steps. No phone tag, no unclear quotes, no guessing who
          to trust.
        </p>
      </div>

      <div class="relative mt-12 grid gap-4 lg:grid-cols-3 lg:gap-6">
        <div class="pointer-events-none absolute top-10 right-[16%] left-[16%] hidden border-t border-dashed border-hairline-strong lg:block"></div>
        {
          steps.map((step) => (
            <div class="card relative p-6 lg:p-7">
              <div class="flex items-center justify-between">
                <span class="flex h-10 w-10 items-center justify-center rounded-full border border-teal-line bg-teal-soft text-teal-deep">
                  <span set:html={icon(step.icon, 'h-4.5 w-4.5')} />
                </span>
                <span class="font-mono text-[11px] tracking-[0.12em] text-faint">{step.number}</span>
              </div>
              <h3 class="mt-6 text-[15px] font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 text-[13px] leading-6 text-body">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================================================= WHY CHOOSE -->
  <section class="border-y border-hairline bg-surface">
    <div class="section-pad container-x">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow">Why choose TrustFix</p>
          <h2 class="display-2 mt-3">A calmer way to get things fixed.</h2>
          <p class="lead mt-4">
            We built TrustFix around the details that make hiring help feel
            simple: clear prices, real profiles and a booking you can actually
            follow.
          </p>

          <div class="mt-7 rounded-xl border border-hairline bg-canvas p-5">
            <div class="flex items-center gap-1 text-amber">
              {
                Array.from({ length: 5 }).map(() => (
                  <span set:html={starIcon('h-3.5 w-3.5')} />
                ))
              }
            </div>
            <p class="mt-3 text-[13px] leading-6 text-body">
              “Booked an electrician in the morning and had my fan fixed the same
              afternoon. The status updates made it so easy.”
            </p>
            <p class="mt-3 text-[11px] font-medium text-ink">Ananya S. · Bengaluru</p>
          </div>

          <a href="/register/customer" class="btn btn-primary mt-6">
            Create your account
            <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
          </a>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            reasons.map((reason) => (
              <div class="rounded-xl border border-hairline bg-canvas/60 p-6">
                <span class="flex h-10 w-10 items-center justify-center rounded-lg border border-hairline bg-surface text-navy">
                  <span set:html={icon(reason.icon, 'h-4.5 w-4.5')} />
                </span>
                <h3 class="mt-5 text-sm font-semibold text-ink">{reason.title}</h3>
                <p class="mt-2 text-[13px] leading-6 text-body">{reason.body}</p>
              </div>
            ))
          }

          <div class="flex items-center gap-4 rounded-xl border border-teal-line bg-teal-soft/70 p-6 sm:col-span-2">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface text-teal-deep">
              <Fragment set:html={icon('shieldCheck', 'h-5 w-5')} />
            </span>
            <div>
              <h3 class="text-sm font-semibold text-ink">Reviews from real bookings</h3>
              <p class="mt-1 text-[13px] leading-5 text-body">
                Only customers with a completed booking can leave a review, so
                ratings stay honest.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================== REVIEWS -->
  <section class="section-pad">
    <div class="container-x">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">Customer stories</p>
          <h2 class="display-2 mt-3">Good work, in their own words.</h2>
        </div>
        <a href="/services" class="btn btn-ghost btn-sm self-start sm:self-auto">
          Explore services
          <Fragment set:html={icon('arrowRight', 'h-3.5 w-3.5')} />
        </a>
      </div>

      <div id="recent-reviews" class="mt-10 grid gap-4 md:grid-cols-3" aria-live="polite">
        {
          Array.from({ length: 3 }).map(() => (
            <div class="card space-y-3 p-6">
              <div class="skeleton h-3.5 w-24"></div>
              <div class="skeleton h-3 w-full"></div>
              <div class="skeleton h-3 w-11/12"></div>
              <div class="skeleton h-3 w-2/3"></div>
              <div class="flex items-center gap-2 pt-3">
                <div class="skeleton h-8 w-8 rounded-full"></div>
                <div class="skeleton h-3 w-28"></div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================== PROVIDER CTA -->
  <section class="pb-16 sm:pb-20 lg:pb-28">
    <div class="container-x">
      <div class="relative overflow-hidden rounded-2xl bg-navy px-6 py-12 text-white sm:px-10 lg:px-14 lg:py-16">
        <div class="pointer-events-none absolute inset-0 opacity-[0.16]" style="background-image: radial-gradient(circle, rgba(255,255,255,.55) 1px, transparent 1px); background-size: 18px 18px;"></div>
        <div class="pointer-events-none absolute -top-24 -right-20 h-72 w-72 rounded-full bg-teal/25 blur-3xl"></div>

        <div class="relative grid items-center gap-10 lg:grid-cols-[1.3fr_0.7fr]">
          <div>
            <p class="font-mono text-[11px] font-medium tracking-[0.14em] text-teal-soft uppercase">
              For service professionals
            </p>
            <h2 class="mt-4 max-w-2xl text-3xl leading-[1.1] font-semibold tracking-[-0.035em] sm:text-4xl">
              Turn your craft into a trusted local business.
            </h2>
            <p class="mt-4 max-w-xl text-[15px] leading-6 text-white/70">
              Create a profile, list your services and receive booking requests
              from customers in your city. You stay in control of every job.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/register/provider" class="btn bg-white text-navy hover:bg-teal-soft">
                Join TrustFix
                <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
              </a>
              <a href="/login" class="btn border border-white/20 text-white hover:bg-white/10">
                Provider log in
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div class="rounded-xl border border-white/12 bg-white/[0.04] p-4 backdrop-blur">
              <p class="text-2xl font-semibold tracking-[-0.03em]">₹0</p>
              <p class="mt-1 text-[11px] leading-4 text-white/60">To create a provider profile</p>
            </div>
            <div class="rounded-xl border border-white/12 bg-white/[0.04] p-4 backdrop-blur">
              <p class="text-2xl font-semibold tracking-[-0.03em]">8</p>
              <p class="mt-1 text-[11px] leading-4 text-white/60">Service categories to join</p>
            </div>
            <div class="rounded-xl border border-white/12 bg-white/[0.04] p-4 backdrop-blur">
              <p class="text-2xl font-semibold tracking-[-0.03em]">1</p>
              <p class="mt-1 text-[11px] leading-4 text-white/60">Simple dashboard for requests</p>
            </div>
            <div class="rounded-xl border border-white/12 bg-white/[0.04] p-4 backdrop-blur">
              <p class="text-2xl font-semibold tracking-[-0.03em]">12</p>
              <p class="mt-1 text-[11px] leading-4 text-white/60">Cities with local customers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // @ts-nocheck
  import { apiFetch, escapeHtml } from '../scripts/api.js';
  import { providerCard, reviewCard, errorState } from '../scripts/render.js';
  import { icon, starIcon } from '../scripts/icons.js';
  import { showToast } from '../scripts/ui.js';

  const locationBtn = document.getElementById('use-location');
  const cityInput = document.getElementById('hero-city');

  locationBtn?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      showToast('Geolocation is not supported by your browser', 'error');
      return;
    }

    navigator.geolocation.getCurrentPosition(async (position) => {
      try {
        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${position.coords.latitude}&lon=${position.coords.longitude}`);
        const data = await response.json();
        if (data.address) {
          const city = data.address.city || data.address.town || data.address.village;
          if (city) {
            cityInput.value = city;
            showToast('Location updated!');
          } else {
            showToast('Could not determine your city', 'info');
          }
        }
      } catch (error) {
        showToast('Failed to fetch location', 'error');
      }
    }, (error) => {
      showToast('Unable to retrieve your location', 'error');
    });
  });

  const providersHost = document.getElementById('featured-providers');
  const reviewsHost = document.getElementById('recent-reviews');

  async function loadProviders() {
    if (!providersHost) return;
    try {
      const { providers } = await apiFetch('/providers?featured=1&limit=4', {
        auth: false,
      });
      providersHost.innerHTML = providers.length
        ? providers.map(providerCard).join('')
        : `<div class="sm:col-span-2 lg:col-span-4">${errorState(
            'Featured professionals will appear here once providers join TrustFix.',
          )}</div>`;
    } catch {
      providersHost.innerHTML = `<div class="sm:col-span-2 lg:col-span-4">
        <div class="empty-state">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-surface-soft text-mute">${icon('users', 'h-5 w-5')}</span>
          <h3 class="mt-4 text-sm font-semibold text-ink">Professionals are loading</h3>
          <p class="mt-1 max-w-sm text-[13px] leading-5 text-body">Start the TrustFix API and import the database to see featured professionals here.</p>
          <a href="/providers" class="btn btn-outline btn-sm mt-5">Browse professionals</a>
        </div>
      </div>`;
    }
  }

  async function loadReviews() {
    if (!reviewsHost) return;
    try {
      const { reviews } = await apiFetch('/reviews/recent?limit=3', { auth: false });
      if (!reviews.length) {
        reviewsHost.innerHTML = `<div class="md:col-span-3">
          <div class="empty-state">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-surface-soft text-mute">${icon('quote', 'h-5 w-5')}</span>
            <h3 class="mt-4 text-sm font-semibold text-ink">Reviews are on the way</h3>
            <p class="mt-1 max-w-sm text-[13px] leading-5 text-body">Completed bookings will show customer reviews here.</p>
          </div>
        </div>`;
        return;
      }

      reviewsHost.innerHTML = reviews
        .map(
          (review) => `<article class="card flex flex-col p-6">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-0.5 text-amber" aria-label="${Number(review.rating)} out of 5 stars">
                ${Array.from({ length: 5 })
                  .map(
                    (_, index) =>
                      `<span class="${index < Number(review.rating) ? 'text-amber' : 'text-hairline-strong'}">${starIcon('h-3.5 w-3.5')}</span>`,
                  )
                  .join('')}
              </div>
              <span class="text-[10px] uppercase tracking-[0.1em] text-mute">${escapeHtml(review.category_name || '')}</span>
            </div>
            <p class="mt-4 flex-1 text-[13px] leading-6 text-body">“${escapeHtml(review.comment || '')}”</p>
            <div class="mt-5 flex items-center gap-2.5 border-t border-hairline pt-4">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-navy-tint text-[10px] font-semibold text-navy">${escapeHtml(
                (review.customer_name || 'TF')
                  .split(/\s+/)
                  .slice(0, 2)
                  .map((part) => part[0] || '')
                  .join(''),
              )}</span>
              <div>
                <p class="text-[11px] font-medium text-ink">${escapeHtml(review.customer_name)}</p>
                <p class="text-[10px] text-mute">${escapeHtml(review.provider_name)} · ${escapeHtml(review.service_title || '')}</p>
              </div>
            </div>
          </article>`,
        )
        .join('');
    } catch {
      reviewsHost.innerHTML = `<div class="md:col-span-3">
        <div class="empty-state">
          <span class="flex h-11 w-11 items-center justify-center rounded-full bg-surface-soft text-mute">${icon('quote', 'h-5 w-5')}</span>
          <h3 class="mt-4 text-sm font-semibold text-ink">Customer reviews</h3>
          <p class="mt-1 max-w-sm text-[13px] leading-5 text-body">Import the TrustFix database and start the API to load real reviews.</p>
        </div>
      </div>`;
    }
  }

  loadProviders();
  loadReviews();
</script>
