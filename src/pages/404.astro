---
import Layout from '../layouts/Layout.astro';
import { icon } from '../scripts/icons.js';
---

<Layout title="Page Not Found" description="The page you were looking for could not be found.">
  <section class="hero-atmosphere">
    <div class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-mono text-[11px] font-medium tracking-[0.14em] text-teal-deep uppercase">Error 404</p>
      <h1 class="display-1 mt-4 max-w-2xl">This page seems to be out on a call.</h1>
      <p class="lead mt-5 max-w-xl">
        The page you were looking for does not exist or has moved. Let us point
        you back to something useful.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Back to home
          <Fragment set:html={icon('arrowRight', 'h-4 w-4')} />
        </a>
        <a href="/services" class="btn btn-outline">Browse services</a>
        <a href="/contact" class="btn btn-ghost">Contact support</a>
      </div>
    </div>
  </section>
</Layout>
